# ============================================================================
# Crystal Finance - Local Environment Example
# ============================================================================

# MySQL database
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=finance
MYSQL_USER=financeuser
MYSQL_PASSWORD=your_secure_password_here
MYSQL_HOST_PORT=3307

# Web API
API_HOST_PORT=8080

# Azure Entra ID / MSAL configuration
AZURE_AD_INSTANCE=https://login.microsoftonline.com
AZURE_AD_TENANT_ID=your_tenant_id_here
AZURE_AD_CLIENT_ID=your_client_id_here
AZURE_AD_CLIENT_SECRET=your_client_secret_here
AZURE_AD_SCOPES=api://your_api_app_id/access_as_user
AZURE_AD_AUTHORIZATION_URL=https://login.microsoftonline.com/your_tenant_id_here/oauth2/v2.0/authorize
AZURE_AD_TOKEN_URL=https://login.microsoftonline.com/your_tenant_id_here/oauth2/v2.0/token
AZURE_AD_AUTHORITY_URL=https://login.microsoftonline.com/your_tenant_id_here
AZURE_AD_APPLICATION_ID_URI=api://your_api_app_id

# Logging
LOG_LEVEL=INFO

